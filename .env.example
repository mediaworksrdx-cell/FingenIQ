# ──────────────────────────────────────────
# FinGenIQ Environment Configuration
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── Application ──────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV=production

# ── Database ─────────────────────────────
# DATABASE_PATH=./data/fingeniq.sqlite

# ── Admin Bootstrap ──────────────────────
# These are only used on first run to seed the initial admin account.
# Change immediately after first deployment.
INITIAL_ADMIN_EMAIL=admin@fingeniq.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# ── Google OAuth (Community) ─────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Community Session ────────────────────
# Must be a strong random secret (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMUNITY_SESSION_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM

# ── Email (Transactional) ────────────────
# Optional: If not set, emails are logged to console in dev.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=FinGenIQ <notifications@fingeniq.com>
