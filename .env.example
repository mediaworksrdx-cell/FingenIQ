# ──────────────────────────────────────────
# FinGenIQ Environment Configuration
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── Application ──────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV=production

# ── Database ─────────────────────────────
# DATABASE_PATH=./data/fingeniq.sqlite

# ── Admin Bootstrap ──────────────────────
# These are only used on first run to seed the initial admin account.
# Change immediately after first deployment.
INITIAL_ADMIN_EMAIL=admin@fingeniq.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# ── Community Discussion (Disqus) ────────
# Optional: If not set, built-in comments are used instead.
# NEXT_PUBLIC_DISQUS_SHORTNAME=fingeniq

# ── Email (Transactional) ────────────────
# Optional: If not set, emails are logged to console in dev.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=FinGenIQ <notifications@fingeniq.com>
